# Immagine ARM64 dal build GIÀ fatto da `vercel build` nel workflow rilascio-unico.yml.
# Non ricompila Next: copia lo standalone e gli asset (quelli nuovi più quelli conservati).
# Le dipendenze di produzione vengono reinstallate per arm64, perché lo standalone
# generato sul runner contiene i binari nativi x64 (per esempio sharp).
# NODE_IMAGE arriva dal workflow (node:<NODE_VERSION>-bookworm-slim): runtime e build sulla stessa versione.
# Contesto preparato dal workflow: standalone/ static/ public/ package.json
# package-lock.json healthcheck.cjs ed eventuali file in CONTESTO_EXTRA (.npmrc, shims/...).
ARG NODE_IMAGE=node:24.22.1-bookworm-slim

FROM ${NODE_IMAGE} AS dipendenze
WORKDIR /deps
COPY extra/ ./
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts=false --no-audit --no-fund

FROM ${NODE_IMAGE} AS runtime
ARG SOURCE_COMMIT
RUN test -n "$SOURCE_COMMIT"
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000 SOURCE_COMMIT=${SOURCE_COMMIT}
RUN groupadd --gid 10001 app && useradd --uid 10001 --gid 10001 --no-create-home app
COPY --chown=10001:10001 standalone/ ./
COPY --from=dipendenze --chown=10001:10001 /deps/node_modules ./node_modules
COPY --chown=10001:10001 static/ ./.next/static/
COPY --chown=10001:10001 public/ ./public/
COPY --chown=10001:10001 healthcheck.cjs ./healthcheck.cjs
RUN mkdir -p /app/.next/cache && chown 10001:10001 /app/.next/cache
LABEL org.opencontainers.image.revision=${SOURCE_COMMIT}
USER 10001:10001
EXPOSE 3000
# Healthcheck in Node (nessun curl nell'immagine): /api/health deve rispondere 200.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD ["node", "healthcheck.cjs"]
CMD ["node", "server.js"]
